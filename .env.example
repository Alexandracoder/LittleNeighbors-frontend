# Backend
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Subida de foto de familia (Cloudinary, unsigned upload preset).
# Ver src/services/imageUpload.ts para instrucciones de configuración.
# Si se dejan vacías, el botón de cambiar foto muestra un aviso claro
# en vez de romper la app.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Subida de documentos de verificación (DNI + selfie). Preset DISTINTO
# y separado del de arriba — ver imageUpload.ts. Si el preset de
# Cloudinary tiene el "Access mode" en "Authenticated", las URLs que
# genera NO se pueden cargar con un <img src=...> normal desde el panel
# de admin (dan 401/403): para verlas ahí, pon el preset en "Public",
# o habrá que servirlas firmadas desde el backend.
VITE_CLOUDINARY_VERIFICATION_PRESET=
